		document.getElementById("latindiv").style.fontFamily =  "Arvo,serif"
	}
	else if (newfont == "work"){
		document.getElementById("latindiv").style.fontFamily =  "Work Sans,sans-serif"
	}
	else if (newfont == "jura"){
		document.getElementById("latindiv").style.fontFamily =  "Jura, sans-serif"
	}
	else if (newfont == "garamond"){
		document.getElementById("latindiv").style.fontFamily =  "EB Garamond, serif"
	}
	else if (newfont == "athena"){
		document.getElementById("latindiv").style.fontFamily =  "New Athena, serif"
	}	
}
</script>

